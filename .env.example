# Apify API Token (required for scraping Google, Microsoft, Flipkart)
# Get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_token_here

# The agents (Ask, deep dive, coverage repair) call free models through a local OmniRoute router.
# Create a key in its dashboard (http://127.0.0.1:20130) and paste it here.
OMNIROUTE_BASE_URL=http://127.0.0.1:20130/v1
OMNIROUTE_MODEL=agent-combo
OMNIROUTE_API_KEY=
